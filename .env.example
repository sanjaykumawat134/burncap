# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (console.upstash.com → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alerts
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Stripe (Dashboard → Developers). Create a "Pro" product with a $29/month price and paste its price ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Preview the UI with sample data and a fake signed-in user. Ignored in production builds.
# BURNCAP_DEMO=1
